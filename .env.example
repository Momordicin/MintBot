DB_PATH=./data/db.sqlite 
DB_ENCRYPTION_KEY=
# 部署驱动的加密开关：本地默认关闭
# 线上 / VPS 部署务必设为 true，FTS 不落盘明文
# 注意：仅对已有数据的 DB 不支持运行时翻转此开关
# 翻转前请使用全新的空 DB（重新加密 / FTS 重建迁移是后续独立任务）
ENCRYPT_SENSITIVE_FIELDS=false
CORE_PORT=3000
# services/core/index.ts
# 注意：package.json 的 dev:ai 脚本目前独立硬编码 --port 8765，没有读这个变量，记得同步改
AI_PORT=8765
ASSET_PATH=./assets 
CHARACTER_PATH=./assets/characters 
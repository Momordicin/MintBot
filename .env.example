DB_PATH=./data/db.sqlite 
DB_ENCRYPTION_KEY=
# 部署驱动的加密开关：本地默认关闭
# 线上 / VPS 部署务必设为 true，FTS 不落盘明文
# 注意：仅对已有数据的 DB 不支持运行时翻转此开关
# 翻转前请使用全新的空 DB（重新加密 / FTS 重建迁移是后续独立任务）
ENCRYPT_SENSITIVE_FIELDS=false
VITE_PORT=18173
CORE_PORT=18300
# services/core/index.ts
AI_PORT=18765
ASSET_PATH=./assets
WALLPAPER_PATH=./data/wallpapers
# 日志目录（可选，留空则用 <项目根>/logs）：核心服务与桌面端共用；桌面端打包后留空则用系统日志目录
LOG_DIR=
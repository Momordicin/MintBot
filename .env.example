DB_PATH=./data/db.sqlite 
VEC_DB_PATH=./data/vec.db 
DB_ENCRYPTION_KEY=
# 部署驱动的加密开关（TDD §3.6）：本地默认关闭（明文 + FTS 可用）；
# 线上 / VPS 部署务必设为 true（AES-256-GCM 加密落盘，此时需同时设置 DB_ENCRYPTION_KEY，FTS 不落盘明文）
# 注意：仅对已有数据的 DB 不支持运行时翻转此开关 —— 不会回填加密已有明文行，也不会清除已落盘的明文 FTS 索引；
# 翻转前请使用全新的空 DB（重新加密 / FTS 重建迁移是后续独立任务）
ENCRYPT_SENSITIVE_FIELDS=false
CORE_PORT=3000 
AI_PORT=8765 
ASSET_PATH=./assets 
CHARACTER_PATH=./assets/characters 
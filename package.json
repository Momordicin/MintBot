{
  "name": "MintBot",
  "version": "1.0.0",
  "description": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:core": "tsx watch services/core/index.ts",
    "dev:ai": "tsx scripts/dev-ai.ts",
    "dev:all": "concurrently -k -n core,app -c cyan,green \"pnpm exec tsx services/core/index.ts\" \"pnpm exec tsx scripts/wait-core.ts && pnpm dev\"",
    "start": "electron .",
    "start:core": "pm2 start ecosystem.config.cjs",
    "build": "electron-vite build",
    "build:all": "pnpm build && pnpm build:core",
    "build:core": "pnpm exec tsc -p shared/tsconfig.json && pnpm exec tsc -p services/core/tsconfig.json && pnpm run verify:core-build",
    "verify:core-build": "node scripts/verify-core-build.mjs",
    "preview": "electron-vite preview",
    "seed": "tsx services/core/db/seed.ts",
    "setup:vendor": "tsx scripts/setup-vendor.ts",
    "setup:ai": "tsx scripts/setup-ai-env.ts",
    "setup:voice": "tsx scripts/setup-voice.ts",
    "demo:fts": "tsx scripts/demos/fts-chinese-search.ts",
    "typecheck": "tsc --build tsconfig.json",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.12",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fastify/cors": "^11.4.2",
    "@fastify/static": "^10.1.10",
    "@mintbot/voice-agent-client": "file:vendor/mintbot-voice-agent-client-0.3.2.tgz",
    "@renovatebot/pep440": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "color2k": "^2.0.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "i18next": "^26.4.6",
    "koffi": "^3.1.6",
    "node-cron": "^4.6.0",
    "openai": "7.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.18",
    "sqlite-vec": "^0.1.9",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^10.0.7",
    "electron": "^42.11.18",
    "electron-vite": "^5.0.0",
    "i18next-cli": "^1.87.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
